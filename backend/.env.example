# Скопируйте этот файл в backend/.env и вставьте НОВЫЙ ключ после перевыпуска.
# Никогда не коммитьте backend/.env и не добавляйте его в архив проекта.
GIGACHAT_CREDENTIALS=
# Альтернатива: путь к локальному файлу, содержащему только ключ.
GIGACHAT_CREDENTIALS_FILE=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat-3-Ultra
GIGACHAT_BASE_URL=https://api.giga.chat/v1
GIGACHAT_AUTH_URL=https://ngw.devices.sberbank.ru:9443/api/v2/oauth

# 0 — реальные запросы, 1 — локальный демонстрационный режим без сети.
GIGACHAT_MOCK=0
# Для реальных медицинских диалогов не подменяем ошибку API демонстрационным ответом.
GIGACHAT_FALLBACK_TO_MOCK=0

# Оставьте проверку SSL включённой. При необходимости укажите путь к сертификату НУЦ Минцифры.
GIGACHAT_VERIFY_SSL=1
GIGACHAT_CA_BUNDLE=certs/russian_trusted_root_ca_pem.crt
GIGACHAT_TIMEOUT=30
